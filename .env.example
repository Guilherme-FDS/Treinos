# Supabase (client: só URL + anon key)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente server/scripts — NUNCA expor ao client
SUPABASE_SERVICE_ROLE_KEY=

# Open Food Facts exige User-Agent identificável: App/versão (contato)
OFF_USER_AGENT=Treinos/0.1 (contato@exemplo.com)

# URL pública do app (redirects de auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth (lidos pelo supabase/config.toml no Supabase local)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Fase 2 (não usado ainda)
ANTHROPIC_API_KEY=
